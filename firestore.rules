rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and private reminders
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /opportunities/{oppId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public shared reminders (safe public read, owner-only write)
    match /shared_reminders/{shareId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
